# ─────────────────────────────────────────────────────────────────────────────
# RepiQR server configuration — copy to Server/.env and fill in.
# NOTHING in this file is a real credential. Never commit a filled-in .env.
# Never expose any of these to client-side JavaScript (only VITE_* vars reach
# the browser, and none of these are VITE_*).
# ─────────────────────────────────────────────────────────────────────────────

# ── Logging ──────────────────────────────────────────────────────────────────
# Console request/event logs are OFF by default (terminal noise during dev).
# Set to "true" to print them again.
SERVER_CONSOLE_LOGS=
# Writing logs to the ServerLog database collection is OFF by default too.
# Set to "true" to resume persisting them. The in-memory admin Live Logs feed
# (this process's own uptime) keeps working either way.
SERVER_DB_LOGS=

# ── Notifications ────────────────────────────────────────────────────────────
# Which provider the notification service uses.
#   mock      (default) simulate everything, nothing leaves the server
#   whatsapp  real sends through the configured BSP below
# Leave as `mock` until WhatsApp is purchased and templates are approved.
NOTIFICATION_PROVIDER=mock

# ── WhatsApp Business API ────────────────────────────────────────────────────
# Which BSP is in use. Providers do NOT share a variable set — fill in the block
# that matches whichever one is bought.
#   meta | gupshup | twilio
WHATSAPP_PROVIDER=

# Webhook (all providers). WHATSAPP_VERIFY_TOKEN is a value you invent and paste
# into the provider console; the handshake fails closed while it is unset.
WHATSAPP_VERIFY_TOKEN=
# App secret for X-Hub-Signature-256 payload verification. Set before going live:
# while unset, webhook payload signatures are NOT checked.
WHATSAPP_APP_SECRET=

# --- Meta WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0

# --- Gupshup ---
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=

# --- Twilio WhatsApp (also used by the legacy channel below) ---
TWILIO_WHATSAPP_NUMBER=

# Send every real notification to this number instead of the true recipient.
# Invaluable while testing; MUST be blank in production.
TEST_WHATSAPP_NUMBER=

# ── SMS (NOT used by any active flow) ────────────────────────────────────────
# SMS is deliberately switched off for this launch: no DLT, no per-message cost.
# The service is kept working so SMS can be reinstated as a fallback channel
# without rebuilding callers. The only remaining callers are the OTP paths
# (phone verification and sticker-activation OTP) — see the audit notes.
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_TEMPLATE_NAME=
# WhatsApp template language locale — MSG91 matches templates by name + locale,
# and the bare 'en' does NOT resolve a template registered under a full locale
# code (e.g. 'en_US', 'en_IN'). Fix "template name (X) does not exist in en" by
# setting this to the exact locale shown in MSG91 dashboard → Templates.
MSG91_WHATSAPP_LANGUAGE_CODE=
# Meta WABA template namespace — required by MSG91 to resolve the template on send.
MSG91_WHATSAPP_TEMPLATE_NAMESPACE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
# Comma-separated allowlist of events permitted to hit a real network.
SMS_LIVE_EVENTS=
WHATSAPP_LIVE_EVENTS=
TEST_SMS_NUMBER=

# ── Email (password reset links + passwordless email-OTP login) ─────────────
# Resend (https://resend.com) is tried first when RESEND_API_KEY is set — a
# plain HTTPS API call, no SMTP transport needed. RESEND_FROM must be an
# address on a domain verified in the Resend dashboard; the sandbox address
# onboarding@resend.dev only delivers to the email on your own Resend account,
# not real users, so it's dev/testing-only.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
# SMTP fallback, used only when RESEND_API_KEY is unset. With neither set,
# emails are logged as [SIMULATED] instead of sent (visible in admin Live Logs).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Razorpay (checkout payments) ─────────────────────────────────────────────
# Test keys (rzp_test_...) never capture real money — switch to live keys
# (rzp_live_...) from the Razorpay dashboard before accepting real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> the secret configured on the /api/webhooks/razorpay
# endpoint. Left unset, that webhook fails closed (503) and payments only get
# marked paid via the browser-side /verify call — so a closed tab or dropped
# connection during a UPI confirmation leaves the order stuck unpaid.
RAZORPAY_WEBHOOK_SECRET=

# ── Core ─────────────────────────────────────────────────────────────────────
MONGODB_URI=
JWT_SECRET=
# The frontend web app's public URL — baked into every QR code image printed
# (Server/models/qrModel.js), and into WhatsApp/chat notification deep links.
# Get this wrong and every sticker's QR code becomes unscannable AND every
# WhatsApp link 404s — it happened once already, see [[deployment-topology]].
# Must be the frontend origin (e.g. https://repiqr.com), never this backend's.
APP_URL=
# Same value as APP_URL in most setups, but distinct on purpose: some code
# reads FRONTEND_URL specifically for CORS origin checks.
FRONTEND_URL=
# THIS backend's own public origin (e.g. https://your-app.onrender.com) — used
# only where something must call back into this server itself: Twilio webhook
# callback URLs and /uploads file links. Never used for anything the user's
# browser navigates to.
BACKEND_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
OPENROUTER_API_KEY=

# ── Web Push (chat/alert notifications reaching a closed tab) ───────────────
# Generate once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Rotating these invalidates every existing browser subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Object storage (chat image attachments only) ─────────────────────────────
# Sticker images are generated on-demand client-side (deterministic from the
# sticker id + colors + template placement) and are never stored server-side.
# Chat attachments are arbitrary user photos and have no such derivation, so
# this is only required once RepiChat's image-sending feature is used.
# Any S3-compatible provider: AWS S3, Cloudflare R2, Backblaze B2, MinIO, ...
# The bucket must be configured for public read (bucket policy or a CDN in
# front of it) — uploads are written with no ACL for cross-provider portability.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only needed for a non-AWS provider (R2/B2/MinIO/...). Leave blank for AWS S3.
S3_ENDPOINT=
# Optional: the public base URL to build file links from (e.g. a CDN domain,
# or the provider's own public bucket URL). If unset, one is derived from
# S3_ENDPOINT/S3_BUCKET/S3_REGION.
S3_PUBLIC_BASE_URL=
