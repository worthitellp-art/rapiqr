# Express Backend Configuration (Server/.env)

PORT=5000

# The deployed frontend origin — used for CORS allowlisting and OAuth/email links.
# Requests from any other origin are rejected.
FRONTEND_URL="https://your-frontend-domain.com"

# JWT signing secret — REQUIRED. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start without this set (no insecure default).
JWT_SECRET="replace-with-a-long-random-secret"

# Admin Fleet Panel login (server-side validated)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Supabase (server-side, service-role — full DB/storage access, keep secret)
SUPABASE_URL="https://your-supabase-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# Google Sign-In (Client ID is public by design; secret only needed if using server-side OAuth flows)
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET=""

# Twilio (masked call bridge, SMS + WhatsApp alert dispatch)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1XXXXXXXXXX"
# WhatsApp-enabled sender — Twilio Sandbox number while testing, or an
# approved WhatsApp Business sender in production. Leave unset to run in
# simulated mode (logged, not actually sent).
TWILIO_WHATSAPP_NUMBER=""

# OpenRouter (Emergency AI Assistant on the scan page — proxied through /api/ai/chat,
# never exposed to the frontend). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# SMTP — activation confirmation emails. Leave unset to run in simulated
# mode (logged instead of actually sent).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@example.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="RapiQR <you@example.com>"
