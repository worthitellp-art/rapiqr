# Supabase Configuration
# Obtain your URL and keys from your Supabase Dashboard project settings (API section)
VITE_SUPABASE_URL="https://your-supabase-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NOTE: OpenRouter (ScanPage AI Assistant) is called server-side only via
# /api/ai/chat — set OPENROUTER_API_KEY in Server/.env, never here. Any
# secret key placed in a VITE_-prefixed var here would ship in the browser bundle.

# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"

# VITE_API_BASE_URL: Base URL of the Express backend API (Render service).
# Used by src/lib/apiClient.ts. Endpoints like /auth/signin are appended.
# In production this is set in .env.production (committed) or as a
# Cloudflare Pages build environment variable.
# VITE_API_BASE_URL="https://YOUR-RENDER-SERVICE.onrender.com/api"

# Admin Fleet Panel credentials — fallback used only when VITE_API_BASE_URL above is NOT set
# (local dev running Vite alone). NOTE: VITE_-prefixed vars are bundled into the client JS,
# so this is not a secret in that build — for production, configure the Express backend and
# set ADMIN_EMAIL / ADMIN_PASSWORD in Server/.env instead, which is validated server-side.
VITE_ADMIN_EMAIL="admin@example.com"
VITE_ADMIN_PASSWORD="change-me"

# Activation confirmation emails — set in Server/.env (not here), used by
# Server/services/emailService.js. Leave unset to run in simulated mode (logged to
# server_logs / admin Live Logs instead of actually sending).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@example.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="RapiQR <you@example.com>"
