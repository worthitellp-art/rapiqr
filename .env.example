# Supabase Configuration
# Obtain your URL and keys from your Supabase Dashboard project settings (API section)
VITE_SUPABASE_URL="https://your-supabase-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Required for OpenRouter AI API calls (used by ScanPage AI Assistant).
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"
