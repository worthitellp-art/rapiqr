# ============================================================
# Production build-time environment variables (frontend only)
# ------------------------------------------------------------
# This file IS committed to the repo on purpose: every VITE_*
# variable here is PUBLIC and gets inlined into the JS bundle
# at build time by Vite. No secrets in this file.
#
# VITE_API_BASE_URL:
#   Base URL of the Express backend API (the Render service).
#   The apiClient appends endpoints like /auth/signin after this.
#
#   Frontend (Cloudflare Workers): https://rapiqr.worthitellp.workers.dev/
#   Backend  (Render):            https://rapiqr.onrender.com
# ============================================================
VITE_API_BASE_URL="https://rapiqr.onrender.com/api"

# Public site URL — used as the OAuth redirect target when NOT on localhost,
# so Google always bounces back to the hosted site (never localhost).
VITE_SITE_URL="https://rapiqr.worthitellp.workers.dev"

# Supabase project connection (PUBLIC keys only — VITE_ vars are inlined into
# the JS bundle by Vite, so anything here is visible to visitors).
# These are committed so Cloudflare CI builds stay reproducible without
# dashboard-only env vars. The anon key is public by design.
VITE_SUPABASE_URL="https://flddzslryxphugbkktkr.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZsZGR6c2xyeXhwaHVnYmtrdGtyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ5NTA0MjMsImV4cCI6MjEwMDUyNjQyM30.gCqVNdMMYSMwgdWnGvZxdYcLOMskt3ynZRsYMesAZ4M"
